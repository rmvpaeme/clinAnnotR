# .rscignore — files excluded from shinyapps.io deployment bundles
# Format is identical to .gitignore (glob patterns, one per line).
# The app needs: inst/shiny/clinannotr/app.R, R/*.R, DESCRIPTION,
#   NAMESPACE, and inst/extdata/ (for example_data()).

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ---- Git ----
.git/
.github/

# ---- R package docs & build artefacts ----
man/
data-raw/
inst/scripts/
Meta/
*.Rd

# ---- Output figures (repo examples, not needed at runtime) ----
example_casereport/
*.png
*.svg
*.pdf
*.eps
*.tiff
Rplot*

# ---- Private / real case data ----
casereport_1/
casereport_2/
casereport_3/

# ---- Root-level dev scripts ----
figure_combined.R
figure_combined_example.R
figure.R
example.R
example_casereport.R
testpackage.R
CLAUDE.md

# ---- Loose Excel / CSV data files in root ----
*.xlsx
*.csv

# ---- README & licence (not needed at runtime) ----
README.md
LICENSE
NEWS.md
